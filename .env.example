NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kompatibilitas proyek Supabase lama; isi salah satu kunci publik saja.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Aktifkan untuk peninjauan berlabel pada lokal, Preview, atau Production MVP yang aksesnya dibatasi.
MODE_PRATINJAU_DATA_CONTOH=false
# URL publik situs, dipakai untuk metadataBase, canonical, sitemap, dan Open Graph.
NEXT_PUBLIC_URL_SITUS=https://www.wawangianpelajar.com

# --- Analitik pengunjung (Umami self-host) ---
# Ketiganya OPSIONAL. Kalau NEXT_PUBLIC_UMAMI_ID_SITUS kosong, tracker tidak
# dirender sama sekali dan situs tetap berjalan normal.
#
# UUID situs dari dasbor Umami (Settings > Websites > Edit).
NEXT_PUBLIC_UMAMI_ID_SITUS=
# URL instance Umami, dipakai untuk rewrite proxy /stats/* di next.config.ts.
# Tanpa ini, /stats/script.js tidak akan tersedia.
UMAMI_URL_INSTANCE=
# Override lokasi skrip tracker. Biarkan kosong agar memakai proxy /stats/script.js
# (lewat domain sendiri, supaya tidak diblokir ad-blocker).
NEXT_PUBLIC_UMAMI_URL_SKRIP=
